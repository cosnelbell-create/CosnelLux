    <script>
        // --- MODULE STORAGE ---
        const StorageModule = {
            MASTER_PASSWORD: "Cosnel2026",
            keys: { gemini: '', alpha: '', coingecko: '' },

            init() {
                this.keys.gemini = localStorage.getItem('cosnel_gemini') || '';
                this.keys.alpha = localStorage.getItem('cosnel_alpha') || '';
                this.keys.coingecko = localStorage.getItem('cosnel_coingecko') || '';
                UiModule.updateApiLed();
            },

            verifyPassword() {
                const pwd = document.getElementById('admin-pwd').value;
                if (pwd === this.MASTER_PASSWORD) {
                    document.getElementById('auth-step').classList.add('hidden');
                    document.getElementById('keys-step').classList.remove('hidden');
                    document.getElementById('key-gemini').value = this.keys.gemini;
                    document.getElementById('key-alpha').value = this.keys.alpha;
                    document.getElementById('key-coingecko').value = this.keys.coingecko;
                } else {
                    const err = document.getElementById('auth-error');
                    err.classList.remove('hidden');
                    setTimeout(() => err.classList.add('hidden'), 3000);
                }
            },

            saveKeys() {
                this.keys.gemini = document.getElementById('key-gemini').value.trim();
                this.keys.alpha = document.getElementById('key-alpha').value.trim();
                this.keys.coingecko = document.getElementById('key-coingecko').value.trim();

                localStorage.setItem('cosnel_gemini', this.keys.gemini);
                localStorage.setItem('cosnel_alpha', this.keys.alpha);
                localStorage.setItem('cosnel_coingecko', this.keys.coingecko);

                UiModule.updateApiLed();
                UiModule.closeSettings();
            }
        };

        // --- MODULE UTILS ---
        const UtilsModule = {
            detectAssetClass(asset) {
                const clean = asset.trim().toUpperCase();
                const cryptoTickers = ['BTC', 'ETH', 'SOL', 'XRP', 'ADA', 'DOGE', 'TON', 'AVAX', 'LINK', 'ARB', 'APT', 'SEI', 'SUI', 'BNB', 'TRX'];
                const isCryptoPattern = cryptoTickers.some(ticker => clean === ticker || clean.startsWith(ticker + ' ') || clean.endsWith(' ' + ticker));
                const isForexPattern = /^[A-Z]{3}\/[A-Z]{3}$|^[A-Z]{6}$/.test(clean) || ['EUR', 'USD', 'GBP', 'JPY', 'CHF', 'AUD', 'CAD'].some(fx => clean.includes(fx) && clean.includes('/'));
                const isMetalPattern = ['XAU', 'GOLD', 'OR', 'XAG', 'SILVER'].some(m => clean.includes(m));

                if (isCryptoPattern) return { type: 'CRYPTO', symbol: clean };
                if (isMetalPattern) return { type: 'METAL', symbol: clean };
                if (isForexPattern) return { type: 'FOREX', symbol: clean };
                return { type: 'UNKNOWN', symbol: clean };
            },

            cleanAndParseJSON(rawText) {
                try {
                    let cleaned = rawText.trim();
                    cleaned = cleaned.replace(/^```json/gi, '').replace(/^```/gi, '').replace(/```$/g, '').trim();
                    const firstBrace = cleaned.indexOf('{');
                    const lastBrace = cleaned.lastIndexOf('}');
                    if (firstBrace !== -1 && lastBrace !== -1) {
                        cleaned = cleaned.substring(firstBrace, lastBrace + 1);
                    }
                    return JSON.parse(cleaned);
                } catch (error) {
                    throw new Error("L'IA a généré une structure textuelle au lieu d'un objet de données pur.");
                }
            },

            mapCryptoId(symbol) {
                const mappings = { 'BTC': 'bitcoin', 'ETH': 'ethereum', 'SOL': 'solana', 'XRP': 'ripple', 'ADA': 'cardano' };
                return mappings[symbol] || symbol.toLowerCase();
            },

            mapAlphaSymbol(symbol, type) {
                if (type === 'METAL') return 'XAUUSD';
                return symbol.replace('/', '').toUpperCase();
            }
        };

        // --- MODULE API ---
        const ApiModule = {
            async fetchCrypto(symbol) {
                if (!StorageModule.keys.coingecko) throw new Error("Clé manquante");
                const coinId = UtilsModule.mapCryptoId(symbol);
                const response = await fetch(`https://api.coingecko.com/api/v3/coins/${coinId}?localization=false&tickers=false`, {
                    headers: { 'x-cg-demo-api-key': StorageModule.keys.coingecko }
                });
                if (!response.ok) throw new Error("Erreur");
                const data = await response.json();
                return {
                    source: "CoinGecko API", prix: `$${data.market_data.current_price.usd}`,
                    var_24h: `${data.market_data.price_change_percentage_24h.toFixed(2)}%`,
                    volume_24h: `$${data.market_data.total_volume.usd.toLocaleString()}`
                };
            },

            async fetchMarketData(symbol, type) {
                if (!StorageModule.keys.alpha) throw new Error("Clé manquante");
                const cleanSymbol = UtilsModule.mapAlphaSymbol(symbol, type);
                const response = await fetch(`https://www.alphavantage.co/query?function=GLOBAL_QUOTE&symbol=${cleanSymbol}&apikey=${StorageModule.keys.alpha}`);
                if (!response.ok) throw new Error("Erreur");
                const data = await response.json();
                const quote = data["Global Quote"];
                if (!quote || !quote["05. price"]) throw new Error("Symbole introuvable");
                return { source: "Alpha Vantage", prix: quote["05. price"], var_24h: quote["10. change percent"] };
            }
        };

        // --- MODULE ANALYSIS ---
        const AnalysisModule = {
            async start() {
                const input = document.getElementById('asset-input').value.trim();
                if (!input) return;
                if (!StorageModule.keys.gemini) { UiModule.openAlert(); return; }

                UiModule.toggleLoading(true);
                UiModule.setLoadingText("Analyse de la typologie...", "Routage vers les serveurs");

                const assetInfo = UtilsModule.detectAssetClass(input);
                let marketData = null;

                if (assetInfo.type === 'CRYPTO') {
                    try { marketData = await ApiModule.fetchCrypto(assetInfo.symbol); } catch(e) { marketData = null; }
                } else if (assetInfo.type === 'FOREX' || assetInfo.type === 'METAL') {
                    try { marketData = await ApiModule.fetchMarketData(assetInfo.symbol, assetInfo.type); } catch(e) { marketData = null; }
                }

                if (!marketData) {
                    UiModule.toggleFallbackBadge(true);
                    marketData = { source: "Grounding Web Intégral" };
                }

                try {
                    UiModule.setLoadingText("Traitement IA Avancé...", "Calcul des matrices stratégiques");
                    const aiResult = await this.callGemini(input, marketData);
                    UiModule.render(aiResult);
                } catch (error) {
                    alert(error.message);
                    UiModule.resetView();
                } finally {
                    UiModule.toggleLoading(false);
                }
            },

            async callGemini(asset, contextData) {
                // Utilisation du modèle de production stable standard
                const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${StorageModule.keys.gemini}`;

                const systemInstruction = `Tu es CosnelLux AI, un conseiller financier d'élite de niveau Wall Street pour l'investisseur Cosnel. Tu es pragmatique et direct. Renvoyez STRICTEMENT votre réponse sous la forme d'un objet JSON valide sans enrobage markdown.
Structure :
{
  "verdict": "ACHAT" ou "VENTE" ou "CONSERVER", "confiance": 90, "prix_analyse": "Prix actuel",
  "analyse_technique": "Synthèse condensée", "must_do": ["Priorité"], "can_do": ["Option"], "stop_doing": ["A éviter"],
  "entree": "Seuil d'entrée", "take_profit": "Objectif haut", "stop_loss": "Invalidation"
}`;

                const payload = {
                    contents: [{ parts: [{ text: `Analyse cet actif : ${asset}. Données : ${JSON.stringify(contextData)}. Utilise ta recherche web en direct.` }] }],
                    systemInstruction: { parts: [{ text: systemInstruction }] },
                    tools: [{ googleSearch: {} }],
                    generationConfig: { responseMimeType: "application/json", temperature: 0.1 }
                };

                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) throw new Error("Incident de communication avec l'API Gemini");
                const responseData = await response.json();
                
                let sources = [];
                try {
                    const chunks = responseData.candidates[0].groundingMetadata.groundingChunks;
                    if(chunks) sources = chunks.filter(c => c.web?.uri).map(c => ({ title: c.web.title, url: c.web.uri }));
                } catch(e){}

                const rawText = responseData.candidates[0].content.parts[0].text;
                const parsedJson = UtilsModule.cleanAndParseJSON(rawText);
                parsedJson._sources = sources;
                return parsedJson;
            }
        };

        // --- MODULE UI ---
        const UiModule = {
            openSettings() {
                const modal = document.getElementById('settings-modal');
                modal.classList.remove('hidden');
                setTimeout(() => modal.classList.remove('opacity-0'), 10);
            },
            closeSettings() {
                const modal = document.getElementById('settings-modal');
                modal.classList.add('opacity-0');
                setTimeout(() => modal.classList.add('hidden'), 300);
            },
            openAlert() { document.getElementById('alert-modal').classList.remove('hidden'); },
            closeAlertAndOpenSettings() { document.getElementById('alert-modal').classList.add('hidden'); this.openSettings(); },
            toggleLoading(show) {
                const screen = document.getElementById('loading-screen');
                const grid = document.getElementById('results-grid');
                if (show) { screen.classList.remove('hidden'); screen.classList.add('flex'); grid.classList.add('hidden'); }
                else { screen.classList.add('hidden'); screen.classList.remove('flex'); }
            },
            setLoadingText(main, sub) {
                document.getElementById('loading-text').textContent = main;
                document.getElementById('loading-subtext').textContent = sub;
            },
            toggleFallbackBadge(show) {
                const badge = document.getElementById('api-fallback-badge');
                if (show) badge.classList.remove('hidden'); else badge.classList.add('hidden');
            },
            updateApiLed() {
                const led = document.getElementById('api-led');
                const text = document.getElementById('api-status-text');
                if (StorageModule.keys.gemini) {
                    led.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.7)]";
                    text.textContent = "Système Prêt";
                } else {
                    led.className = "w-2.5 h-2.5 rounded-full bg-rose-500 shadow-[0_0_12px_rgba(244,63,94,0.7)]";
                    text.textContent = "Configuration Requise";
                }
            },
            resetView() {
                document.getElementById('search-section').classList.remove('hidden');
                document.getElementById('results-grid').classList.add('hidden');
            },
            render(data) {
                document.getElementById('results-grid').classList.remove('hidden');
                const badge = document.getElementById('verdict-badge');
                badge.textContent = data.verdict;
                badge.className = "px-10 py-4 rounded-2xl text-3xl font-black tracking-widest mb-6 border shadow-2xl transition-all duration-500 ";
                
                if (data.verdict === "ACHAT") badge.className += "bg-emerald-500/10 text-emerald-400 border-emerald-500/30";
                else if (data.verdict === "VENTE") badge.className += "bg-rose-500/10 text-rose-400 border-rose-500/30";
                else badge.className += "bg-lux-500/10 text-lux-400 border-lux-500/30";

                document.getElementById('confidence-val').textContent = `${data.confiance}%`;
                document.getElementById('confidence-bar').style.width = `${data.confiance}%`;
                document.getElementById('current-price').textContent = data.prix_analyse;
                document.getElementById('technical-analysis').textContent = data.analyse_technique;

                this.fillList('list-must', data.must_do);
                this.fillList('list-can', data.can_do);
                this.fillList('list-stop', data.stop_doing);

                document.getElementById('price-entry').textContent = data.entree;
                document.getElementById('price-tp').textContent = data.take_profit;
                document.getElementById('price-sl').textContent = data.stop_loss;

                const sc = document.getElementById('grounding-sources-container');
                const lw = document.getElementById('grounding-links');
                lw.innerHTML = '';
                if(data._sources && data._sources.length > 0) {
                    sc.classList.remove('hidden');
                    data._sources.forEach(s => {
                        const a = document.createElement('a'); a.href = s.url; a.target = "_blank";
                        a.className = "bg-slate-900 border border-slate-800 px-2 py-1 rounded text-sky-400 block max-w-xs truncate";
                        a.textContent = s.title || 'Source';
                        lw.appendChild(a);
                    });
                } else { sc.classList.add('hidden'); }

                document.getElementById('search-section').classList.add('scale-90', 'mb-8');
                document.querySelector('#search-section h2').classList.add('hidden');
            },
            fillList(id, array) {
                const ul = document.getElementById(id); ul.innerHTML = '';
                if (Array.isArray(array)) {
                    array.forEach(t => { const li = document.createElement('li'); li.textContent = t; ul.appendChild(li); });
                }
            }
        };

        document.addEventListener('DOMContentLoaded', () => StorageModule.init());
    </script>
</body>
</html>
