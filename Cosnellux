    <script>
        // ==========================================
        // MODULE /STORAGE : Gestion de la persistance locale
        // ==========================================
        const StorageModule = {
            MASTER_PASSWORD: "Cosnel2026",
            keys: { gemini: '', alpha: '', coingecko: '' },

            init() {
                this.keys.gemini = localStorage.getItem('cosnel_gemini') || '';
                this.keys.alpha = localStorage.getItem('cosnel_alpha') || '';
                this.keys.coingecko = localStorage.getItem('cosnel_coingecko') || '';
                UiModule.updateApiLed();
            },

            verifyPassword() {
                const pwd = document.getElementById('admin-pwd').value;
                if (pwd === this.MASTER_PASSWORD) {
                    document.getElementById('auth-step').classList.add('hidden');
                    document.getElementById('keys-step').classList.remove('hidden');
                    document.getElementById('key-gemini').value = this.keys.gemini;
                    document.getElementById('key-alpha').value = this.keys.alpha;
                    document.getElementById('key-coingecko').value = this.keys.coingecko;
                } else {
                    const err = document.getElementById('auth-error');
                    err.classList.remove('hidden');
                    setTimeout(() => err.classList.add('hidden'), 3000);
                }
            },

            saveKeys() {
                this.keys.gemini = document.getElementById('key-gemini').value.trim();
                this.keys.alpha = document.getElementById('key-alpha').value.trim();
                this.keys.coingecko = document.getElementById('key-coingecko').value.trim();

                localStorage.setItem('cosnel_gemini', this.keys.gemini);
                localStorage.setItem('cosnel_alpha', this.keys.alpha);
                localStorage.setItem('cosnel_coingecko', this.keys.coingecko);

                UiModule.updateApiLed();
                UiModule.closeSettings();
            }
        };

        // ==========================================
        // MODULE /UTILS : Algorithmes et Parsing résilients
        // ==========================================
        const UtilsModule = {
            // Détecteur polymorphique avancé
            detectAssetClass(asset) {
                const clean = asset.trim().toUpperCase();
                
                // Base Crypto Etendue par Regex
                const cryptoTickers = ['BTC', 'ETH', 'SOL', 'XRP', 'ADA', 'DOGE', 'TON', 'AVAX', 'LINK', 'ARB', 'APT', 'SEI', 'SUI', 'BNB', 'TRX', 'DOT', 'NEAR', 'MATIC'];
                const isCryptoPattern = cryptoTickers.some(ticker => clean === ticker || clean.startsWith(ticker + ' ') || clean.endsWith(' ' + ticker));
                
                // Base Forex par Regex
                const isForexPattern = /^[A-Z]{3}\/[A-Z]{3}$|^[A-Z]{6}$/.test(clean) || ['EUR', 'USD', 'GBP', 'JPY', 'CHF', 'AUD', 'CAD'].some(fx => clean.includes(fx) && clean.includes('/'));

                // Base Métaux précieux
                const isMetalPattern = ['XAU', 'GOLD', 'OR', 'XAG', 'SILVER', 'ARGENT', 'PLATINUM', 'PALLADIUM'].some(m => clean.includes(m));

                if (isCryptoPattern) return { type: 'CRYPTO', symbol: clean };
                if (isMetalPattern) return { type: 'METAL', symbol: clean };
                if (isForexPattern) return { type: 'FOREX', symbol: clean };
                
                return { type: 'UNKNOWN', symbol: clean };
            },

            // Extracteur et Nettoyeur Ultra-Robuste de JSON
            cleanAndParseJSON(rawText) {
                try {
                    let cleaned = rawText.trim();
                    // Élimination des délimitations markdown courantes
                    cleaned = cleaned.replace(/^```json/gi, '').replace(/^```/gi, '').replace(/```$/g, '').trim();
                    
                    const firstBrace = cleaned.indexOf('{');
                    const lastBrace = cleaned.lastIndexOf('}');
                    
                    if (firstBrace !== -1 && lastBrace !== -1) {
                        cleaned = cleaned.substring(firstBrace, lastBrace + 1);
                    }
                    return JSON.parse(cleaned);
                } catch (error) {
                    console.error("Format JSON brut corrompu par l'IA:", rawText);
                    throw new Error("L'intelligence distribuée a renvoyé une structure non conforme au parseur.");
                }
            },

            // Dictionnaire ID CoinGecko pour tickers clés
            mapCryptoId(symbol) {
                const mappings = {
                    'BTC': 'bitcoin', 'ETH': 'ethereum', 'SOL': 'solana', 'XRP': 'ripple',
                    'ADA': 'cardano', 'DOGE': 'dogecoin', 'TON': 'the-open-network',
                    'AVAX': 'avalanche-2', 'LINK': 'chainlink', 'ARB': 'arbitrum',
                    'APT': 'aptos', 'SEI': 'sei-network', 'SUI': 'sui', 'BNB': 'binancecoin', 'TRX': 'tron'
                };
                return mappings[symbol] || symbol.toLowerCase();
            },

            // Normalisation des symboles pour Alpha Vantage
            mapAlphaSymbol(symbol, type) {
                if (type === 'METAL') {
                    if (symbol.includes('OR') || symbol.includes('GOLD') || symbol.includes('XAU')) return 'XAUUSD';
                    if (symbol.includes('ARGENT') || symbol.includes('SILVER') || symbol.includes('XAG')) return 'XAGUSD';
                }
                return symbol.replace('/', '').toUpperCase();
            }
        };

        // ==========================================
        // MODULE /API : Protocoles réseau (CoinGecko & Alpha Vantage)
        // ==========================================
        const ApiModule = {
            async fetchCrypto(symbol) {
                if (!StorageModule.keys.coingecko) throw new Error("Clé CoinGecko absente");
                const coinId = UtilsModule.mapCryptoId(symbol);
                const url = `https://api.coingecko.com/api/v3/coins/${coinId}?localization=false&tickers=false&community_data=false&developer_data=false&sparkline=false`;
                
                const response = await fetch(url, {
                    headers: { 'x-cg-demo-api-key': StorageModule.keys.coingecko }
                });
                if (!response.ok) throw new Error(`Status CoinGecko: ${response.status}`);
                
                const data = await response.json();
                const market = data.market_data;
                return {
                    source: "CoinGecko V3 Complet",
                    prix: `$${market.current_price.usd}`,
                    var_24h: `${market.price_change_percentage_24h.toFixed(2)}%`,
                    volume_24h: `$${market.total_volume.usd.toLocaleString()}`,
                    market_cap: `$${market.market_cap.usd.toLocaleString()}`,
                    rank: `#${data.market_cap_rank}`,
                    supply: `${market.circulating_supply.toLocaleString()} ${data.symbol.toUpperCase()}`
                };
            },

            async fetchMarketData(symbol, type) {
                if (!StorageModule.keys.alpha) throw new Error("Clé Alpha Vantage absente");
                const cleanSymbol = UtilsModule.mapAlphaSymbol(symbol, type);
                
                // Appel Temps Réel GLOBAL_QUOTE
                const quoteUrl = `https://www.alphavantage.co/query?function=GLOBAL_QUOTE&symbol=${cleanSymbol}&apikey=${StorageModule.keys.alpha}`;
                const quoteResponse = await fetch(quoteUrl);
                if (!quoteResponse.ok) throw new Error("Erreur réseau Alpha Vantage Quote");
                const quoteData = await quoteResponse.json();
                const quote = quoteData["Global Quote"];

                if (!quote || !quote["05. price"]) {
                    throw new Error("Symbole introuvable ou quota atteint sur Alpha Vantage");
                }

                let marketContext = {
                    source: "Alpha Vantage High-Frequency",
                    prix: quote["05. price"],
                    var_24h: quote["10. change percent"],
                    volume_24h: quote["06. volume"] || "N/A",
                    tendance: parseFloat(quote["09. change"]) >= 0 ? "HAUSSIÈRE" : "BAISSIÈRE",
                    context_journalier: `Haut: ${quote["03. high"]} | Bas: ${quote["04. low"]}`
                };

                // Enrichissement optionnel via FX_DAILY pour le Forex
                if (type === 'FOREX') {
                    try {
                        const fromCurrency = cleanSymbol.substring(0,3);
                        const toCurrency = cleanSymbol.substring(3,6);
                        const fxUrl = `https://www.alphavantage.co/query?function=FX_DAILY&from_symbol=${fromCurrency}&to_symbol=${toCurrency}&apikey=${StorageModule.keys.alpha}`;
                        const fxRes = await fetch(fxUrl);
                        if (fxRes.ok) {
                            const fxData = await fxRes.json();
                            if (fxData["Time Series FX (Daily)"]) {
                                const dates = Object.keys(fxData["Time Series FX (Daily)"]);
                                if (dates.length > 0) {
                                    marketContext.context_journalier += ` | Clôture veille: ${fxData["Time Series FX (Daily)"][dates[0]]["4. close"]}`;
                                }
                            }
                        }
                    } catch (e) { console.warn("Enrichissement FX_DAILY ignoré", e); }
                }

                return marketContext;
            }
        };

        // ==========================================
        // MODULE /ANALYSIS : Moteur d'Analyse IA Gemini
        // ==========================================
        const AnalysisModule = {
            async start() {
                const input = document.getElementById('asset-input').value.trim();
                if (!input) return;

                if (!StorageModule.keys.gemini) {
                    UiModule.openAlert();
                    return;
                }

                UiModule.toggleLoading(true);
                UiModule.setLoadingText("Analyse de la typologie d'actif...", "Routage vers les serveurs de détection algorithmique");
                UiModule.toggleFallbackBadge(false);

                const assetInfo = UtilsModule.detectAssetClass(input);
                let marketData = null;
                let apiFailed = false;

                // ETAPE 1: Tentative de récupération via API dures
                if (assetInfo.type === 'CRYPTO') {
                    try {
                        UiModule.setLoadingText("Extraction des registres CoinGecko API...", "Récupération des volumes, capitalisations et supply");
                        marketData = await ApiModule.fetchCrypto(assetInfo.symbol);
                    } catch (e) {
                        console.warn("Échec CoinGecko, déclenchement du protocole de résilience", e);
                        apiFailed = true;
                    }
                } else if (assetInfo.type === 'FOREX' || assetInfo.type === 'METAL') {
                    try {
                        UiModule.setLoadingText("Interconnexion Alpha Vantage Real-Time...", "Calcul des spreads et agrégations des tendances");
                        marketData = await ApiModule.fetchMarketData(assetInfo.symbol, assetInfo.type);
                    } catch (e) {
                        console.warn("Échec Alpha Vantage, déclenchement du protocole de résilience", e);
                        apiFailed = true;
                    }
                } else {
                    // Actif Atypique détecté d'office (Pi Network, etc.)
                    apiFailed = true;
                }

                // ETAPE 2 & 3: Gestion du Système de Fallback / Fusion de données
                if (apiFailed || !marketData) {
                    UiModule.toggleFallbackBadge(true);
                    UiModule.setLoadingText("Activation du Fallback Souverain...", "Routage exclusif vers Gemini Search Grounding en temps réel");
                    marketData = {
                        source: "Gemini Google Search Grounding Intégral",
                        note: "Les API dures ont échoué ou l'actif est atypique. Données extraites en direct des flux macroéconomiques globaux."
                    };
                }

                // ETAPE 4: Appel au Moteur Gemini avec Extended Thinking Natif
                try {
                    UiModule.setLoadingText("Instanciation de Gemini (Thinking Mode Négocié)...", "Raisonnement logique en cours sur les marchés mondiaux");
                    const aiResult = await this.callGemini(input, marketData);
                    UiModule.render(aiResult);
                } catch (error) {
                    console.error("Échec critique du moteur IA:", error);
                    alert("Erreur critique de calcul de l'IA : " + error.message);
                    UiModule.resetView();
                } finally {
                    UiModule.toggleLoading(false);
                }
            },

            async callGemini(asset, contextData) {
                // Modèle mis à jour vers les standards optimisés supportant nativement l'Extended Thinking
                const targetModel = "gemini-1.5-flash";
                const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/${targetModel}:generateContent?key=${StorageModule.keys.gemini}`;

                const systemInstruction = `Tu es CosnelLux AI, un conseiller financier privé d'élite de niveau Wall Street, travaillant exclusivement pour l'investisseur privé Cosnel. Tu es pragmatique, analytique et d'une franchise absolue. Tu n'utilises jamais de jargon flou ni de phrases d'évitement sur les risques. Tu prends des décisions tranchées.
Tu analyses les données techniques fournies et les croises avec tes recherches web instantanées issues de ton outil de recherche Google (sentiments du marché, actualités macro, régulations).

Tu renverras STRICTEMENT ta réponse finale sous la forme d'un objet JSON brut et valide, sans aucun enrobage markdown.
Structure JSON exigée :
{
  "verdict": "ACHAT" ou "VENTE" ou "CONSERVER",
  "confiance": 90,
  "prix_analyse": "Chaîne du prix analysé",
  "analyse_technique": "Synthèse condensée macro, RSI, MM et actualités chaudes",
  "must_do": ["Action impérative 1", "Action impérative 2"],
  "can_do": ["Opportunité optionnelle 1"],
  "stop_doing": ["Erreur à éviter impérativement"],
  "entree": "Seuil d'entrée",
  "take_profit": "Objectif de sortie haute",
  "stop_loss": "Invalidation"
}`;

                const prompt = `Analyse stratégique requise pour l'investisseur Cosnel. Actif cible : ${asset}.
Contexte technique extrait des API sous-jacentes : ${JSON.stringify(contextData)}.
Exécute tes requêtes de recherche web en temps réel si des données manquent ou pour corroborer la macroéconomie actuelle.`;

                // Payload intégrant la syntaxe officielle et native du mode Extended Thinking (thinkingConfig)
                // ainsi que le Google Search Tool pour le Grounding en temps réel.
                const payload = {
                    contents: [{ parts: [{ text: prompt }] }],
                    systemInstruction: { parts: [{ text: systemInstruction }] },
                    tools: [{ googleSearch: {} }],
                    generationConfig: {
                        responseMimeType: "application/json",
                        thinkingConfig: {
                            thinkingBudget: 2048 // Budget de réflexion élevé alloué nativement
                        },
                        temperature: 0.1
                    }
                };

                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    const errJson = await response.json();
                    throw new Error(errJson.error?.message || "Incident réseau API Gemini");
                }

                const responseData = await response.json();
                
                // Récupération et extraction des sources de Grounding (Google Search Sources)
                let sources = [];
                try {
                    const candidate = responseData.candidates?.[0];
                    if (candidate?.groundingMetadata?.groundingChunks) {
                        sources = candidate.groundingMetadata.groundingChunks
                            .filter(chunk => chunk.web?.uri)
                            .map(chunk => ({ title: chunk.web.title, url: chunk.web.uri }));
                    }
                } catch(e) { console.warn("Impossible d'extraire les métadonnées de grounding", e); }

                const rawText = responseData.candidates[0].content.parts[0].text;
                const parsedJson = UtilsModule.cleanAndParseJSON(rawText);
                
                // Injection dynamique des sources récoltées pour traitement UI
                parsedJson._sources = sources;
                return parsedJson;
            }
        };

        // ==========================================
        // MODULE /UI : Gestion de l'affichage de l'interface premium
        // ==========================================
        const UiModule = {
            openSettings() {
                const modal = document.getElementById('settings-modal');
                modal.classList.remove('hidden');
                setTimeout(() => modal.classList.remove('opacity-0'), 10);
                document.getElementById('auth-step').classList.remove('hidden');
                document.getElementById('keys-step').classList.add('hidden');
                document.getElementById('admin-pwd').value = '';
            },

            closeSettings() {
                const modal = document.getElementById('settings-modal');
                modal.classList.add('opacity-0');
                setTimeout(() => modal.classList.add('hidden'), 300);
            },

            openAlert() {
                document.getElementById('alert-modal').classList.remove('hidden');
            },

            closeAlertAndOpenSettings() {
                document.getElementById('alert-modal').classList.add('hidden');
                this.openSettings();
            },

            toggleLoading(show) {
                const screen = document.getElementById('loading-screen');
                const grid = document.getElementById('results-grid');
                if (show) {
                    screen.classList.remove('hidden');
                    screen.classList.add('flex');
                    grid.classList.add('hidden');
                } else {
                    screen.classList.add('hidden');
                    screen.classList.remove('flex');
                }
            },

            setLoadingText(main, sub) {
                document.getElementById('loading-text').textContent = main;
                document.getElementById('loading-subtext').textContent = sub;
            },

            toggleFallbackBadge(show) {
                const badge = document.getElementById('api-fallback-badge');
                if (show) badge.classList.remove('hidden');
                else badge.classList.add('hidden');
            },

            updateApiLed() {
                const led = document.getElementById('api-led');
                const text = document.getElementById('api-status-text');
                if (StorageModule.keys.gemini) {
                    led.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.7)]";
                    text.textContent = "Système Sécurisé";
                    text.className = "text-emerald-400 hidden sm:inline-block font-medium tracking-wide";
                } else {
                    led.className = "w-2.5 h-2.5 rounded-full bg-rose-500 shadow-[0_0_12px_rgba(244,63,94,0.7)]";
                    text.textContent = "Configuration Requise";
                    text.className = "text-rose-400 hidden sm:inline-block font-medium tracking-wide";
                }
            },

            resetView() {
                document.getElementById('search-section').classList.remove('hidden');
                document.getElementById('results-grid').classList.add('hidden');
                document.querySelector('#search-section h2').classList.remove('hidden');
                document.getElementById('search-section').classList.remove('scale-90', 'transform', 'origin-top', 'mb-8');
                document.getElementById('search-section').classList.add('mb-12');
            },

            render(data) {
                const grid = document.getElementById('results-grid');
                grid.classList.remove('hidden');

                // 1. Position / Verdict Visuel Élite
                const badge = document.getElementById('verdict-badge');
                badge.textContent = data.verdict;
                badge.className = "px-10 py-4 rounded-2xl text-3xl font-black tracking-widest mb-6 border shadow-2xl transition-all duration-500 ";
                
                if (data.verdict === "ACHAT") {
                    badge.className += "bg-emerald-500/10 text-emerald-400 border-emerald-500/30 shadow-[0_0_30px_rgba(16,185,129,0.25)]";
                } else if (data.verdict === "VENTE") {
                    badge.className += "bg-rose-500/10 text-rose-400 border-rose-500/30 shadow-[0_0_30px_rgba(244,63,94,0.25)]";
                } else {
                    badge.className += "bg-lux-500/10 text-lux-400 border-lux-500/30 shadow-[0_0_30px_rgba(245,158,11,0.25)]";
                }

                // Jauge algorithmique
                document.getElementById('confidence-val').textContent = `${data.confiance}%`;
                setTimeout(() => {
                    document.getElementById('confidence-bar').style.width = `${data.confiance}%`;
                }, 100);

                // 2. Prix et synthèse textuelle
                document.getElementById('current-price').textContent = data.prix_analyse;
                document.getElementById('technical-analysis').textContent = data.analyse_technique;
                
                const sourceBadge = document.getElementById('price-source-badge');
                sourceBadge.textContent = document.getElementById('api-fallback-badge').classList.contains('hidden') ? "Données API Fondamentales" : "Vérification Grounding Web";

                // 3. Matrice d'action
                this.fillList('list-must', data.must_do);
                this.fillList('list-can', data.can_do);
                this.fillList('list-stop', data.stop_doing);

                // 4. Cartographie des prix stratégiques
                document.getElementById('price-entry').textContent = data.entree;
                document.getElementById('price-tp').textContent = data.take_profit;
                document.getElementById('price-sl').textContent = data.stop_loss;

                // 5. Affichage dynamique des Sources Grounding (Google Search References)
                const sourcesContainer = document.getElementById('grounding-sources-container');
                const linksWrapper = document.getElementById('grounding-links');
                linksWrapper.innerHTML = '';
                
                if (data._sources && data._sources.length > 0) {
                    sourcesContainer.classList.remove('hidden');
                    data._sources.forEach(src => {
                        const a = document.createElement('a');
                        a.href = src.url;
                        a.target = "_blank";
                        a.className = "bg-slate-900 hover:bg-slate-800 text-sky-400 border border-slate-800 px-2 py-1 rounded flex items-center gap-1 transition-all max-w-xs truncate";
                        a.innerHTML = `<i class="fa-solid fa-link text-[9px] text-slate-500"></i> ${src.title || 'Source Référence'}`;
                        linksWrapper.appendChild(a);
                    });
                } else {
                    sourcesContainer.classList.add('hidden');
                }

                // Ajustement ergonomique du module de recherche haut
                const searchSec = document.getElementById('search-section');
                searchSec.classList.remove('mb-12');
                searchSec.classList.add('mb-8', 'scale-90', 'transform', 'origin-top');
                document.querySelector('#search-section h2').classList.add('hidden');
            },

            fillList(id, array) {
                const ul = document.getElementById(id);
                ul.innerHTML = '';
                if (Array.isArray(array)) {
                    array.forEach(text => {
                        const li = document.createElement('li');
                        li.textContent = text;
                        ul.appendChild(li);
                    });
                }
            }
        };

        // Instanciation de l'application à chaud
        document.addEventListener('DOMContentLoaded', () => StorageModule.init());
    </script>
</body>
